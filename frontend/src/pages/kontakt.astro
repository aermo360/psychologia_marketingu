---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const SITE = "https://psychologiamarketingu.edu.pl";
const IRK_URL =
    "https://irk.usos.pwr.edu.pl/pl/offer/PDS_2025_2026/programme/PDS-PKMP-000P-NNPW2/?from=field:PKM";

// FormSubmit: po aktywacji skrzynki mozna podmienic adres na losowy string
// (formsubmit.co/<losowy-string>), zeby nie trzymac maila w HTML — patrz CLAUDE.md.
const FORM_ENDPOINT = "https://formsubmit.co/arek@rebelpixel.pl";

const pageDescription =
    "Masz pytanie o studia podyplomowe Psychologia komunikacji marketingowej na PWr? Napisz przez formularz — odpowiadamy w dni robocze.";

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        { "@type": "ListItem", position: 1, name: "Strona główna", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Kontakt", item: `${SITE}/kontakt/` },
    ],
};

const inputClass =
    "w-full rounded-xl border border-[#e6dbdb] dark:border-[#3d2a2a] bg-white dark:bg-[#1a0c0c] px-4 py-3 text-base text-[#181111] dark:text-white placeholder:text-gray-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60 focus-visible:border-primary transition-all";
const labelClass = "block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2";
---

<Layout
    title="Kontakt — Psychologia marketingu | PWr"
    description={pageDescription}
    jsonLd={[breadcrumbSchema]}
>
    <Header />
    <main class="flex-1" id="main-content">
        <section class="max-w-[1280px] mx-auto px-6 lg:px-20 pt-16 pb-8">
            <div class="flex items-center gap-2 text-sm text-gray-500 mb-6">
                <a class="hover:text-primary" href="/">Strona główna</a>
                <span class="material-symbols-outlined text-xs" aria-hidden="true">chevron_right</span>
                <span class="text-gray-900 dark:text-white font-medium" aria-current="page">Kontakt</span>
            </div>
            <h1 class="text-4xl lg:text-5xl font-black text-[#181111] dark:text-white tracking-tight mb-4">
                Kontakt
            </h1>
            <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl">
                Masz pytanie o rekrutację, program albo opłaty? Napisz przez formularz —
                odpowiadamy w dni robocze.
            </p>
        </section>

        <section class="max-w-[1280px] mx-auto px-6 lg:px-20 pb-24">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
                <div class="lg:col-span-2">
                    <div
                        id="form-sukces"
                        role="status"
                        hidden
                        class="mb-8 rounded-2xl border border-primary/30 bg-primary/5 dark:bg-primary/10 p-6"
                    >
                        <p class="font-bold text-[#181111] dark:text-white mb-1">
                            Dziękujemy — wiadomość została wysłana.
                        </p>
                        <p class="text-sm text-gray-600 dark:text-gray-400">
                            Odpowiemy na podany adres e-mail w dni robocze.
                        </p>
                    </div>

                    <form action={FORM_ENDPOINT} method="POST" class="flex flex-col gap-6">
                        <!-- Konfiguracja FormSubmit -->
                        <input type="hidden" name="_subject" value="Zapytanie ze strony Psychologia marketingu" />
                        <input type="hidden" name="_template" value="table" />
                        <input type="hidden" name="_next" value={`${SITE}/kontakt/?wyslano=1`} />
                        <!-- Honeypot: boty wypelniaja, ludzie nie widza -->
                        <input type="text" name="_honey" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true" />

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label class={labelClass} for="name">Imię i nazwisko</label>
                                <input class={inputClass} type="text" id="name" name="name" required autocomplete="name" />
                            </div>
                            <div>
                                <label class={labelClass} for="email">Adres e-mail</label>
                                <input class={inputClass} type="email" id="email" name="email" required autocomplete="email" />
                            </div>
                        </div>

                        <div>
                            <label class={labelClass} for="temat">Czego dotyczy pytanie?</label>
                            <select class={inputClass} id="temat" name="temat" required>
                                <option value="">Wybierz temat</option>
                                <option value="Rekrutacja i wymagane dokumenty">Rekrutacja i wymagane dokumenty</option>
                                <option value="Opłaty i raty">Opłaty i raty</option>
                                <option value="Program i organizacja zajęć">Program i organizacja zajęć</option>
                                <option value="Inne">Inne</option>
                            </select>
                        </div>

                        <div>
                            <label class={labelClass} for="message">Wiadomość</label>
                            <textarea class={inputClass} id="message" name="message" rows="7" required></textarea>
                        </div>

                        <div class="flex items-start gap-3">
                            <input
                                type="checkbox"
                                id="zgoda"
                                name="zgoda"
                                value="Wyrazono zgode na przetwarzanie danych"
                                required
                                class="mt-1 h-5 w-5 shrink-0 rounded border-[#e6dbdb] dark:border-[#3d2a2a] text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60"
                            />
                            <label class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed" for="zgoda">
                                Wyrażam zgodę na przetwarzanie moich danych osobowych w celu udzielenia
                                odpowiedzi na zapytanie. Szczegóły w
                                <a class="text-primary font-semibold hover:underline" href="/polityka-prywatnosci/">polityce prywatności</a>.
                            </label>
                        </div>

                        <button
                            type="submit"
                            class="bg-primary text-white h-14 px-8 rounded-xl font-bold text-lg hover:shadow-lg transition-all active:scale-95 self-start"
                            >Wyślij wiadomość</button
                        >
                    </form>
                </div>

                <aside class="lg:col-span-1">
                    <div class="rounded-2xl bg-primary/5 dark:bg-primary/10 border border-primary/20 p-8 lg:sticky lg:top-8">
                        <h2 class="font-bold mb-6 text-sm uppercase tracking-widest text-primary">
                            Dział Kształcenia PWr
                        </h2>
                        <ul class="space-y-5 text-sm text-gray-700 dark:text-gray-300">
                            <li class="flex items-start gap-3">
                                <span class="material-symbols-outlined text-primary text-lg" aria-hidden="true">person</span>
                                <span>Anna Fąfara</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <span class="material-symbols-outlined text-primary text-lg" aria-hidden="true">call</span>
                                <a class="hover:text-primary transition-colors" href="tel:+48713407515">tel. 71 340 75 15</a>
                            </li>
                            <li class="flex items-start gap-3">
                                <span class="material-symbols-outlined text-primary text-lg" aria-hidden="true">location_on</span>
                                <span>bud. L-1, pok. 120<br />ul. Na Grobli 15<br />50-421 Wrocław</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <span class="material-symbols-outlined text-primary text-lg" aria-hidden="true">schedule</span>
                                <span>Odpowiadamy w dni robocze</span>
                            </li>
                        </ul>

                        <div class="mt-8 pt-8 border-t border-primary/20">
                            <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
                                Wiesz już, że chcesz aplikować?
                            </p>
                            <a
                                href={IRK_URL}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center justify-center w-full bg-primary text-white h-12 px-6 rounded-xl font-bold hover:shadow-lg transition-all active:scale-95"
                                >Zapisz się przez IRK</a
                            >
                        </div>
                    </div>
                </aside>
            </div>
        </section>
    </main>
    <Footer />
</Layout>

<script is:inline>
    // FormSubmit wraca na /kontakt/?wyslano=1 — pokaz potwierdzenie i posprzataj URL,
    // zeby odswiezenie strony nie pokazywalo go ponownie.
    (function () {
        if (new URLSearchParams(window.location.search).get("wyslano") !== "1") return;
        var box = document.getElementById("form-sukces");
        if (box) {
            box.hidden = false;
            box.scrollIntoView({ behavior: "smooth", block: "center" });
        }
        history.replaceState(null, "", window.location.pathname);
    })();
</script>
