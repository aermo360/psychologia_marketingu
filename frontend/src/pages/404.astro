---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const pageDescription =
    "Nie znaleziono strony — studia podyplomowe Psychologia komunikacji marketingowej na Politechnice Wrocławskiej.";
---

<Layout title="Nie znaleziono strony (404) | Psychologia marketingu PWr" description={pageDescription} noindex={true}>
    <Header />
    <main class="flex-1">
        <section class="max-w-[1280px] mx-auto px-6 lg:px-20 py-24 lg:py-32">
            <div class="max-w-2xl">
                <span class="text-primary font-black text-7xl lg:text-8xl tracking-tight block mb-6">404</span>
                <h1 class="text-3xl lg:text-4xl font-black text-[#181111] dark:text-white tracking-tight mb-4">
                    Nie znaleźliśmy tej strony
                </h1>
                <p class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed mb-10">
                    Adres mógł się zmienić albo zawiera literówkę. Poniżej znajdziesz najczęściej
                    odwiedzane sekcje serwisu.
                </p>

                <div class="flex flex-col sm:flex-row gap-4 mb-12">
                    <a
                        href="/"
                        class="bg-primary text-white h-14 px-8 rounded-xl font-bold text-lg hover:shadow-lg transition-all active:scale-95 flex items-center justify-center"
                        >Wróć na stronę główną</a
                    >
                    <a
                        href="/rekrutacja/"
                        class="border-2 border-[#e6dbdb] dark:border-[#3d2a2a] h-14 px-8 rounded-xl font-bold text-lg text-gray-700 dark:text-gray-300 hover:border-primary/40 transition-all flex items-center justify-center"
                        >Rekrutacja i opłaty</a
                    >
                </div>

                <nav aria-label="Popularne podstrony">
                    <ul class="flex flex-wrap gap-x-6 gap-y-3 text-base font-semibold">
                        <li><a class="text-primary hover:underline" href="/program/">Program studiów</a></li>
                        <li><a class="text-primary hover:underline" href="/dla-kogo/">Dla kogo</a></li>
                        <li><a class="text-primary hover:underline" href="/wykladowcy/">Wykładowcy</a></li>
                        <li><a class="text-primary hover:underline" href="/faq/">FAQ</a></li>
                        <li><a class="text-primary hover:underline" href="/blog/">Blog</a></li>
                    </ul>
                </nav>
            </div>
        </section>
    </main>
    <Footer />
</Layout>
